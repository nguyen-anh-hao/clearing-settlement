# clearing-settlement local defaults (match trading-infra-deploy)
# Requires JDK 21; Maven uses JAVA_HOME.
SERVER_PORT=8083
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/settlement
SPRING_DATASOURCE_USERNAME=settlement
SPRING_DATASOURCE_PASSWORD=settlement
ACCOUNTING_OUTBOX_ENABLED=true
SCHEMA_REGISTRY_URL=http://localhost:8081
LOG_LEVEL=INFO
OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
